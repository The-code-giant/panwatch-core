# Fresh-install defaults: local access, schedulers and update polling disabled.

# Credentials. Set these BEFORE the first start: until a password exists the app
# does not require a login, so an unset password on a non-loopback bind is an
# open instance. They seed the account once and are ignored afterwards -- change
# the password from Settings, not here.
AUTH_USERNAME=
AUTH_PASSWORD=
# Session signing key. Use a long random value, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

TICKERKEEP_PORT=18080
DISABLE_SCHEDULERS=1
UPDATE_CHECK_DISABLE=1
TZ=America/Vancouver

# Replace the reserved example address and model before enabling an agent.
# Never put real keys in version control.
AI_BASE_URL=https://model.example.invalid/v1
AI_MODEL=configure-your-model
AI_API_KEY=

# Optional notification configuration; empty values send nothing.
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
